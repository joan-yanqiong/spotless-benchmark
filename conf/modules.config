/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {
    // Setting defaults
    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: "copy",
        saveAs: { filename ->
            if (filename.equals('versions.yml') | filename == "ok.txt") {
                null
            }
            else {
                filename
            }
        }
    ]
    withLabel: container_seuratdisk {
            container ='csangara/seuratdisk:latest'

    }

    withLabel: container_tidyverse {
        container = 'rocker/tidyverse:latest'
    }

    withLabel: container_cell2location {
        container  = 'csangara/sp_cell2location:latest'
    }

    withName: COMPUTE_METRICS {
        container = 'csangara/sp_eval:latest'
    }
    withLabel: container_destvi {
        container = 'csangara/sp_destvi:latest'
    }
    withLabel: container_sp_dstg {
        container ='csangara/sp_dstg:latest'

    } 
    withLabel: container_music {
        container = 'csangara/sp_music:latest'

    }
    withName: NNLS_RUN {
        container = 'csangara/sp_nnls:latest'
    }

    withName: MUSIC_RUN {
        errorStrategy =  { task.exitStatus in 137..140 ? 'retry' : 'terminate' }
        maxRetries = 2
    }

    withName: RCTD_RUN {
        container ='csangara/sp_rctd:latest'
    }

    withName: SEURAT_RUN {
        container = 'csangara/seurat:latest'
        errorStrategy = { task.exitStatus in 137..140 ? 'retry' : 'terminate' }
        maxRetries= 2
    
    }

    withName: SPATIAL_DWLS_RUN {
        container = 'csangara/sp_spatialdwls:latest'
    }
    withName: SPOTLIGHT_RUN {
        container = 'csangara/sp_spotlight:latest'

    }

    withLabel: container_stereoscope {
        container = 'csangara/sp_stereoscope:latest'
    }

    withLabel: container_stride {
        container= 'csangara/sp_stride:latest'
    }

    withName: TANGRAM_RUN {
        container = 'csangara/sp_tangram:latest'

    }
}
